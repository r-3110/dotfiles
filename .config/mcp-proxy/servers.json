{
  "mcpServers": {
    "markitdown-mcp": {
      "command": "markitdown-mcp",
      "args": []
    },
    "semgrep": {
      "command": "uvx",
      "args": ["semgrep", "mcp"]
    },
    "dbhub": {
      "command": "npx",
      "args": [
        "@bytebase/dbhub@latest",
        "--config",
        "~/dotfiles/.config/dbhub/dbhub.toml",
        "--transport",
        "stdio"
      ]
    }
  }
}
